@using BitzArt.Blazor.Cookies
@using System.Globalization
@using System.Net.Mail
@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Localization
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@using kvwleidingmerch.Components.Form
@using kvwleidingmerch.Data
@inherits LayoutComponentBase
@inject IDialogService DialogService
@inject ICookieService CookieService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> Localizer
@inject AppDbContext DbContext
@inject CartService CartService
@inject Microsoft.Extensions.Options.IOptions<EmailSettings> EmailOptions
@inject IEmailSchedulerService EmailSchedulerService
@implements IDisposable

<FluentDesignTheme Mode="@_themeMode" ModeChanged="OnThemeModeChangedAsync" StorageName="kvw-design-theme">
    <div class="page @(_themeMode == DesignThemeModes.Dark ? "theme-dark" : "theme-light")">
        <main>
            <div class="top-row px-4">
                @if (owner)
                {
                    <FluentButton Appearance="Appearance.Accent"
                                  IconStart="@(new Icons.Regular.Size20.Add())"
                                  OnClick="OpenAddProductDialogAsync">
                        @Localizer["AddProduct"]
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Accent"
                                  IconStart="@(new Icons.Regular.Size20.Mail())"
                                  OnClick="OpenManageOrderRecipientsDialogAsync">
                        @Localizer["ManageOrderEmails"]
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Accent"
                                  IconStart="@(new Icons.Regular.Size20.Clock())"
                                  OnClick="OpenScheduleEmailDialogAsync">
                        @Localizer["ScheduleEmail"]
                    </FluentButton>
                }
                <div class="language-switcher">
                    <FluentSwitch Value="@(_themeMode == DesignThemeModes.Dark)"
                                  ValueChanged="OnThemeSwitchChangedAsync"
                                  Class="theme-toggle">
                        <FluentIcon Value="@GetThemeIcon()"
                                    Class="theme-toggle__icon" />
                    </FluentSwitch>
                    <FluentLabel Class="language-switcher__label">@Localizer["Language"]</FluentLabel>
                    <FluentSelect TOption="string"
                                  Value="@_selectedCulture"
                                  ValueChanged="OnLanguageChangedAsync"
                                  Width="140px"
                                  AriaLabel="Select language"
                                  Appearance="Appearance.Stealth">
                        <FluentOption Value="nl-NL">Nederlands</FluentOption>
                        <FluentOption Value="en-US">English</FluentOption>
                    </FluentSelect>
                </div>
            </div>

            <CascadingValue Name="IsOwner" Value="@owner">
            <CascadingValue Name="IsAccess" Value="@access">
                <article class="content px-4">
                    @Body
                </article>
            </CascadingValue>
            </CascadingValue>
        </main>
    </div>
</FluentDesignTheme>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<FluentDialogProvider />

@if (access && !owner)
{
    <FluentButton Appearance="Appearance.Stealth"
                  OnClick="OpenCartDialogAsync"
                  Title="@Localizer["Cart"]"
                  Class="cart-fab">
        <FluentIcon Value="@(new Icons.Regular.Size20.Cart())" />
        @if (CartService.TotalCount > 0)
        {
            <span class="cart-count-badge">@CartService.TotalCount</span>
        }
    </FluentButton>
}

@code {
    private static readonly TimeSpan CultureCookieLifetime = TimeSpan.FromDays(365);
    private string _selectedCulture = "nl-NL";
    private DesignThemeModes _themeMode = DesignThemeModes.Dark;

    [SupplyParameterFromQuery]
    [Parameter]
    public string? url { get; set; }

    public bool owner = false;

    public bool access = false;

    private string InitialEmailDialogTitle
    {
        get
        {
            var configuredTitle = EmailOptions.Value.Title;
            return string.IsNullOrWhiteSpace(configuredTitle)
                ? "KVW Tilburg Noord merch"
                : configuredTitle;
        }
    }

    protected override void OnInitialized()
    {
        CartService.OnCartChanged += OnCartChanged;
        var accessUrl = DbContext.AccessLinks.OrderByDescending(a => a.CreatedAtUtc).FirstOrDefault();
        var ownerUrl = DbContext.AccessLinks.OrderBy(a => a.Id).FirstOrDefault()?.UrlValue;

        if (string.IsNullOrWhiteSpace(url) || (!string.Equals(url, accessUrl?.UrlValue) && !string.Equals(url, ownerUrl)))
            NavigationManager.NotFound();
        else
            access = true;

        if (string.Equals(url, ownerUrl))
            owner = true;

        _selectedCulture = NormalizeCulture(CultureInfo.CurrentUICulture.Name);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await CartService.InitializeAsync();
        StateHasChanged();

        if (await HasValidEmailCookieAsync() || owner || !access)
            return;

        DialogParameters parameters = new DialogParameters
        {
            Title = InitialEmailDialogTitle,
            PrimaryAction = null,
            SecondaryAction = null,
            Width = "400px",
            TrapFocus = true,
            Modal = true,
            PreventDismissOnOverlayClick = true,
            ShowDismiss = false,
            SecondaryActionEnabled = false,
        };

        await DialogService.ShowDialogAsync<EnterEmailForm>(parameters);
    }

    private Task OnThemeModeChangedAsync(DesignThemeModes mode)
    {
        _themeMode = mode;
        return Task.CompletedTask;
    }

    private Task OnThemeSwitchChangedAsync(bool isDark)
    {
        _themeMode = isDark ? DesignThemeModes.Dark : DesignThemeModes.Light;
        return Task.CompletedTask;
    }

    private Icon GetThemeIcon()
        => _themeMode == DesignThemeModes.Dark
            ? new Icons.Regular.Size20.WeatherMoon()
            : new Icons.Regular.Size20.WeatherSunny();

    private async Task OnLanguageChangedAsync(string? culture)
    {
        if (string.IsNullOrWhiteSpace(culture))
            return;

        await ChangeLanguageAsync(culture);
    }

    private async Task ChangeLanguageAsync(string culture)
    {
        var normalizedCulture = NormalizeCulture(culture);

        if (_selectedCulture == normalizedCulture)
            return;

        _selectedCulture = normalizedCulture;

        await CookieService.SetAsync(
            CookieRequestCultureProvider.DefaultCookieName,
            CookieRequestCultureProvider.MakeCookieValue(new RequestCulture(normalizedCulture)),
            DateTimeOffset.UtcNow.Add(CultureCookieLifetime));

        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }

    private static string NormalizeCulture(string culture)
        => culture.StartsWith("nl", StringComparison.OrdinalIgnoreCase) ? "nl-NL" : "en-US";

    private async Task<bool> HasValidEmailCookieAsync()
    {
        Cookie? email = await CookieService.GetAsync("email");

        if (email is not null && !string.IsNullOrWhiteSpace(email.Value))
        {
            try
            {
                var decoded = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(email.Value)).Trim();
                if (MailAddress.TryCreate(decoded, out _))
                    return true;
            }
            catch
            {
            }
        }

        await CookieService.RemoveAsync("email");
        return false;
    }

    private async Task OpenAddProductDialogAsync()
    {
        var model = new kvwleidingmerch.Data.AddProductModel();

        var parameters = new DialogParameters<kvwleidingmerch.Data.AddProductModel>
        {
            Content = model,
            Title = Localizer["AddProduct"],
            PrimaryAction = null,
            SecondaryAction = null,
            Width = "480px",
            TrapFocus = true,
            Modal = true,
        };

        await DialogService.ShowDialogAsync<AddProductDialog>(model, parameters);
    }

    private async Task OpenManageOrderRecipientsDialogAsync()
    {
        var parameters = new DialogParameters
        {
            Title = Localizer["ManageOrderEmails"],
            PrimaryAction = null,
            SecondaryAction = null,
            Width = "480px",
            TrapFocus = true,
            Modal = true,
        };

        await DialogService.ShowDialogAsync<ManageOrderRecipientsDialog>(parameters);
    }

    private async Task OpenScheduleEmailDialogAsync()
    {
        var parameters = new DialogParameters
        {
            Title = Localizer["ScheduleEmail"],
            PrimaryAction = null,
            SecondaryAction = null,
            Width = "480px",
            TrapFocus = true,
            Modal = true,
        };

        await DialogService.ShowDialogAsync<ScheduleEmailDialog>(parameters);
    }

    private async Task OpenCartDialogAsync()
    {
        var parameters = new DialogParameters
        {
            Title = Localizer["Cart"],
            PrimaryAction = null,
            SecondaryAction = null,
            Width = "480px",
            Modal = true,
        };

        await DialogService.ShowDialogAsync<CartDialog>(parameters);
    }

    private void OnCartChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        CartService.OnCartChanged -= OnCartChanged;
    }
}
