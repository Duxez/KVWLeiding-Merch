@using Microsoft.Extensions.Localization
@using System.Text
@using System.Globalization
@using BitzArt.Blazor.Cookies
@using kvwleidingmerch.Data
@inject CartService CartService
@inject ICookieService CookieService
@inject IOrderEmailService OrderEmailService
@inject AppDbContext DbContext
@inject IStringLocalizer<SharedResource> Localizer
@implements IDialogContentComponent

<FluentDialogBody>
    @if (!CartService.Items.Any())
    {
        <FluentLabel Style="opacity:0.6">@Localizer["CartIsEmpty"]</FluentLabel>
    }
    else
    {
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
            @for (int i = 0; i < CartService.Items.Count; i++)
            {
                var item = CartService.Items[i];
                var index = i;
                <div class="cart-item">
                    <div class="cart-item-info">
                        <FluentLabel Typo="Typography.Subject">@item.ProductTitle</FluentLabel>
                        <FluentLabel Typo="Typography.Body">@item.UnitPrice.ToString("C", CultureInfo.CurrentCulture)</FluentLabel>
                        @if (!string.IsNullOrWhiteSpace(item.SizeName) || !string.IsNullOrWhiteSpace(item.ColorName))
                        {
                            <div class="cart-item-badges">
                                @if (!string.IsNullOrWhiteSpace(item.SizeName))
                                {
                                    <FluentBadge Appearance="Appearance.Accent">@item.SizeName</FluentBadge>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.ColorName))
                                {
                                    <FluentBadge>
                                        @if (!string.IsNullOrWhiteSpace(item.ColorHex))
                                        {
                                            <span class="color-dot" style="background-color:@item.ColorHex"></span>
                                        }
                                        @item.ColorName
                                    </FluentBadge>
                                }
                            </div>
                        }
                    </div>
                    <FluentButton Appearance="Appearance.Stealth"
                                  IconStart="@(new Icons.Regular.Size16.Delete())"
                                  Title="@Localizer["Delete"]"
                                  @onclick="() => CartService.RemoveAt(index)" />
                </div>
            }
        </FluentStack>

        <FluentStack Orientation="Orientation.Horizontal"
                     HorizontalAlignment="HorizontalAlignment.End"
                     style="padding-top:8px;border-top:1px solid var(--neutral-stroke-rest, #e0e0e0)">
            <FluentLabel Weight="FontWeight.Bold">Total: @CartTotal.ToString("C", CultureInfo.CurrentCulture)</FluentLabel>
        </FluentStack>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <FluentLabel Style="color:#b42318">@_errorMessage</FluentLabel>
    }
</FluentDialogBody>

<FluentDialogFooter>
    <FluentStack Orientation="Orientation.Horizontal"
                 VerticalAlignment="VerticalAlignment.Center"
                 HorizontalGap="8"
                 style="width:100%;display:flex;flex-wrap:nowrap;align-items:center">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
            <FluentButton OnClick="CloseAsync">@Localizer["Close"]</FluentButton>
            @if (CartService.Items.Any())
            {
                <FluentButton OnClick="ClearAsync">@Localizer["EmptyCart"]</FluentButton>
            }
        </FluentStack>

        <div style="margin-left:auto;display:flex;align-items:center">
            <FluentButton Appearance="Appearance.Accent"
                          OnClick="SendOrderAsync"
                          Disabled="@(!CartService.Items.Any() || _isSending)">
                @Localizer["SendOrder"]
            </FluentButton>
        </div>
    </FluentStack>
</FluentDialogFooter>

@code {
    [CascadingParameter]
    public FluentDialog Dialog { get; set; } = default!;

    private bool _isSending;
    private string? _errorMessage;
    private decimal CartTotal => CartService.Items.Sum(i => i.UnitPrice);

    private async Task CloseAsync() => await Dialog.CancelAsync();

    private async Task ClearAsync()
    {
        CartService.Clear();
        await Dialog.CancelAsync();
    }

    private async Task SendOrderAsync()
    {
        _errorMessage = null;
        _isSending = true;

        try
        {
            var customerEmail = await GetCustomerEmailAsync();
            if (string.IsNullOrWhiteSpace(customerEmail))
            {
                _errorMessage = Localizer["OrderEmailMissing"];
                return;
            }

            var total = CartService.Items.Sum(i => i.UnitPrice);
            
            var order = new Order
            {
                CustomerEmail = customerEmail,
                TotalAmount = total,
                CreatedAtUtc = DateTime.UtcNow,
                Status = "Completed"
            };

            foreach (var item in CartService.Items)
            {
                order.Items.Add(new OrderItem
                {
                    ProductId = item.ProductId,
                    ProductTitle = item.ProductTitle,
                    UnitPrice = item.UnitPrice,
                    SizeId = item.SizeId,
                    SizeName = item.SizeName,
                    ColorId = item.ColorId,
                    ColorName = item.ColorName,
                    ColorHex = item.ColorHex
                });
            }

            DbContext.Orders.Add(order);
            await DbContext.SaveChangesAsync();

            await OrderEmailService.SendOrderAsync(customerEmail, CartService.Items);
            CartService.Clear();
            await Dialog.CloseAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSending = false;
        }
    }

    private async Task<string?> GetCustomerEmailAsync()
    {
        Cookie? emailCookie = await CookieService.GetAsync("email");
        if (emailCookie is null || string.IsNullOrWhiteSpace(emailCookie.Value))
            return null;

        try
        {
            var bytes = Convert.FromBase64String(emailCookie.Value);
            var decoded = Encoding.UTF8.GetString(bytes).Trim();
            return string.IsNullOrWhiteSpace(decoded) ? null : decoded;
        }
        catch
        {
            return null;
        }
    }
}
